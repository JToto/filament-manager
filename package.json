{
  "name": "filament-manager",
  "version": "2.0.0",
  "description": "Web-App (Angular + Node/SQLite) zum Verwalten von 3D-Druck Filament-Spulen, Herstellern und Druckkosten",
  "main": "server.js",
  "scripts": {
    "build": "ng build",
    "start": "ng build && node --no-warnings server.js",
    "serve": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js"
  },
  "dependencies": {
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
